<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Launch screen: plain vibrant green (asset LaunchScreenBackground). The launch animation
	     uses the matching green (see the note in LaunchAnimationView), so it starts from the same colour with no white flash. Other Info.plist keys are still generated
	     from the build settings. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
	</dict>
</dict>
</plist>
